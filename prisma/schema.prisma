generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ACTIVE
  ENDED
  RESULT_PUBLISHED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  INTERNAL_ERROR
}

enum TestResultStatus {
  PASSED
  FAILED
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

enum ViolationType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  CLIPBOARD_COPY
  CLIPBOARD_PASTE
  WINDOW_BLUR
  DEVTOOLS_ATTEMPT
  RIGHT_CLICK
}

enum Severity {
  WARNING
  FINAL_WARNING
  CRITICAL
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(STUDENT)
  usn          String?       // University Seat Number / Roll No
  department   String?       // e.g. Computer Science
  semester     Int?
  division     String?       // e.g. "A", "B"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdExams Exam[]        @relation("ExamCreator")
  questions    Question[]    @relation("QuestionAuthor")
  attempts     ExamAttempt[]
  violations   Violation[]
  auditLogs    AuditLog[]

  @@index([role])
  @@index([email])
}

model Exam {
  id                         String         @id @default(cuid())
  title                      String
  description                String         @db.Text
  instructions               String?        @db.Text
  duration                   Int            // In minutes
  startTime                  DateTime
  endTime                    DateTime
  status                     ExamStatus     @default(DRAFT)
  maxAttempts                Int            @default(1)
  violationLimit             Int            @default(3)
  autoSubmit                 Boolean        @default(true)
  allowedLanguages           String         @default("c,cpp,java,python,javascript")
  passPercentage             Float          @default(40.0)
  totalMarks                 Int            @default(100)
  enableFullscreen           Boolean        @default(true)
  enableTabMonitoring        Boolean        @default(true)
  enableClipboardRestrictions Boolean       @default(true)
  enableRightClickDisable    Boolean        @default(true)
  targetDepartment           String?
  targetSemester             Int?

  createdById                String
  createdBy                  User           @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Cascade)

  examQuestions              ExamQuestion[]
  attempts                   ExamAttempt[]
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  @@index([status])
  @@index([startTime, endTime])
  @@index([createdById])
}

model Question {
  id               String         @id @default(cuid())
  title            String
  slug             String?
  description      String         @db.Text
  inputFormat      String         @db.Text
  outputFormat     String         @db.Text
  constraints      String         @db.Text
  difficulty       Difficulty     @default(MEDIUM)
  allowedLanguages String         @default("c,cpp,java,python,javascript")
  timeLimit        Int            @default(2000) // Milliseconds
  memoryLimit      Int            @default(256)  // Megabytes
  defaultMarks     Int            @default(10)
  starterCode      String?        @db.Text       // JSON string mapping lang -> starter code
  tags             String?        @default("algorithms")

  createdById      String
  createdBy        User           @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  testCases        TestCase[]
  examQuestions    ExamQuestion[]
  submissions      Submission[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([difficulty])
  @@index([createdById])
}

model TestCase {
  id             String                 @id @default(cuid())
  questionId     String
  question       Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  input          String                 @db.Text
  expectedOutput String                 @db.Text
  explanation    String?                @db.Text
  marks          Int                    @default(5)
  isHidden       Boolean                @default(false)
  orderIndex     Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  testResults    SubmissionTestResult[]

  @@index([questionId])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  marks      Int      @default(10)

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
}

model ExamAttempt {
  id                 String         @id @default(cuid())
  examId             String
  exam               Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId          String
  student            User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status             AttemptStatus  @default(NOT_STARTED)
  startedAt          DateTime?
  submittedAt        DateTime?
  endTime            DateTime?      // Server authoritative deadline for this attempt
  totalScore         Float          @default(0)
  percentage         Float          @default(0)
  violationCount     Int            @default(0)
  currentQuestionId  String?
  autosavedCode      String?        @db.LongText // JSON mapping questionId -> { code, language, timestamp }
  ipAddress          String?
  userAgent          String?

  submissions        Submission[]
  violations         Violation[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([status])
}

model Submission {
  id             String                 @id @default(cuid())
  attemptId      String
  attempt        ExamAttempt            @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language       String
  sourceCode     String                 @db.LongText
  status         SubmissionStatus       @default(PENDING)
  score          Float                  @default(0)
  passedCount    Int                    @default(0)
  totalTestCases Int                    @default(0)
  executionTime  Int?                   // ms
  memoryUsed     Float?                 // MB
  stdout         String?                @db.Text
  stderr         String?                @db.Text
  compileOutput  String?                @db.Text

  testResults    SubmissionTestResult[]
  submittedAt    DateTime               @default(now())

  @@index([attemptId])
  @@index([questionId])
  @@index([status])
}

model SubmissionTestResult {
  id             String           @id @default(cuid())
  submissionId   String
  submission     Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCaseId     String
  testCase       TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  status         TestResultStatus
  actualOutput   String?          @db.Text
  expectedOutput String?          @db.Text // Will be empty or omitted for hidden test cases in student view
  executionTime  Int?             // ms
  marksEarned    Float            @default(0)
  errorMessage   String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([submissionId])
  @@index([testCaseId])
}

model Violation {
  id        String        @id @default(cuid())
  attemptId String
  attempt   ExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId String
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      ViolationType
  severity  Severity      @default(WARNING)
  metadata  String?       @db.Text
  timestamp DateTime      @default(now())

  @@index([attemptId])
  @@index([studentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
